# WhispeRM — workspace-level environment variables.
#
# This file documents variables shared across the monorepo (root scripts, Prisma, E2E tests).
# Each app also has its own .env.example with app-specific variables:
#   apps/web/.env.example, apps/api/.env.example, apps/worker/.env.example
#
# Never commit real secrets. Copy this file to .env (gitignored) and fill in real values.

# --- Database (Prisma, prisma/schema.prisma) ---------------------------------------------------
# Required by any command that touches the database: prisma generate/migrate, seed scripts,
# `pnpm doctor`. Local Postgres, Neon, and Supabase all work -- the schema uses plain
# `postgresql`, nothing vendor-specific.
DATABASE_URL=

# Only meaningful when DATABASE_URL is a pooled connection (e.g. Supabase's pgbouncer pooler on
# port 6543). prisma/schema.prisma currently reads DATABASE_URL only -- DIRECT_URL is not wired
# into the schema's datasource block. Documented here because docs/production-deployment.md's
# migration step expects a direct (non-pooled) connection string; export it as DATABASE_URL
# yourself when running `prisma migrate deploy` against a pooled production database.
DIRECT_URL=

# --- Redis (queue/runtime features) -------------------------------------------------------------
# Required only if/when apps/worker is wired to a durable queue backend. As of this slice,
# apps/worker's queue runtime is in-memory and does not read REDIS_URL -- see
# docs/production-deployment.md and README.md "Known gaps". `pnpm doctor` WARNs (does not fail)
# when this is unset.
REDIS_URL=

# --- Auth ----------------------------------------------------------------------------------------
# WhispeRM's real authentication provider is Clerk (see apps/web/.env.example for
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY / CLERK_SECRET_KEY). The variables below are NOT read by any
# code in this repo today -- they are reserved placeholders only, kept here so a NextAuth-based
# service could be dropped in without a workspace-wide env rename. Leave unset for local dev.
NEXTAUTH_SECRET=
NEXTAUTH_URL=
AUTH_SECRET=

# --- Vercel preview/E2E automation --------------------------------------------------------------
# Set on Vercel preview deployments to bypass Vercel's deployment-protection screen for automated
# checks (Playwright, uptime pings). See apps/web/playwright.config.ts. Not required locally.
VERCEL_AUTOMATION_BYPASS_SECRET=

# --- End-to-end tests (apps/web/e2e, see apps/web/e2e/README.md) --------------------------------
# Credentials for a real Clerk user in a Clerk *test* instance. Every authenticated Playwright
# spec calls test.skip() when these are unset -- the E2E suite is a no-op without them.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# --- Demo seed (scripts/seed-demo.mjs -> prisma/demo-seed.mjs) ----------------------------------
# WHISPERM_DEMO_USER_EMAIL must be the email you sign in with via Clerk: apps/web resolves your
# workspace by matching your signed-in Clerk email against a TenantUser row
# (apps/web/src/lib/get-tenant.ts), so the seed is the only way to attach a login to a populated
# demo workspace. Re-running the seed is safe (idempotent).
WHISPERM_DEMO_TENANT_SLUG=demo
WHISPERM_DEMO_USER_EMAIL=

{
  "name": "@whisperm/services",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint test/*.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @whisperm/types build && pnpm --filter @whisperm/campaign-runtime build && pnpm --filter @whisperm/repositories build && pnpm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@whisperm/campaign-runtime": "workspace:*",
    "@whisperm/provider-adapters": "workspace:^",
    "@whisperm/repositories": "workspace:*",
    "@whisperm/types": "workspace:*",
    "resend": "^6.12.4",
    "zod": "3.25.76"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./campaign-targeting": {
      "types": "./dist/campaign-targeting.d.ts",
      "import": "./dist/campaign-targeting.js",
      "default": "./dist/campaign-targeting.js"
    },
    "./acquisition-workflow": {
      "types": "./dist/acquisition-workflow.d.ts",
      "import": "./dist/acquisition-workflow.js",
      "default": "./dist/acquisition-workflow.js"
    },
    "./acquisition-metrics": {
      "types": "./dist/acquisition-metrics.d.ts",
      "import": "./dist/acquisition-metrics.js",
      "default": "./dist/acquisition-metrics.js"
    }
  }
}

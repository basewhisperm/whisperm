# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Database (Neon)
DATABASE_URL=postgresql://...

# App
NEXT_PUBLIC_API_URL=https://api.whisperm.io
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Seller invitation claim link (ST1-013J) -- required, no implicit default. Use an absolute
# http(s) URL: http://localhost:3000/claim locally, your Vercel preview URL in preview, the real
# production domain in production. See README.md for details.
SELLER_INVITATION_BASE_URL=http://localhost:3000/claim

# Seller invitation providers (ST1-013J) -- all optional; leave unset to keep a channel disabled.
# GET /api/marketplace-acquisition/provider-health reports which channels are actually usable.
# WhatsApp (Meta Cloud API):
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=
# Only 0 or 1 is supported -- see README.md known limitation.
WHATSAPP_TEMPLATE_BODY_PARAM_COUNT=1
# SMS (generic HTTP provider):
SELLER_INVITATION_SMS_API_URL=
SELLER_INVITATION_SMS_API_KEY=
SELLER_INVITATION_SMS_SENDER_ID=
# Email (Resend) -- used as a fallback when a seller has no phone:
RESEND_API_KEY=
EMAIL_FROM=

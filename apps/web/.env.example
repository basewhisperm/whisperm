# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Database (Neon)
DATABASE_URL=postgresql://...

# App
NEXT_PUBLIC_API_URL=https://api.whisperm.io
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Vercel preview/automation -- set on Vercel preview deployments so automated checks (Playwright,
# uptime pings) can bypass Vercel's deployment-protection screen. Read by playwright.config.ts.
# Not required for local dev.
VERCEL_AUTOMATION_BYPASS_SECRET=

# End-to-end tests (see e2e/README.md for the full variable reference). Credentials for a real
# Clerk user in a Clerk *test* instance -- every authenticated Playwright spec calls test.skip()
# when these are unset, so the E2E suite is a no-op without them.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Seller invitation claim link (ST1-013J) -- required, no implicit default. Use an absolute
# http(s) URL: http://localhost:3000/claim locally, your Vercel preview URL in preview, the real
# production domain in production. See README.md for details.
SELLER_INVITATION_BASE_URL=http://localhost:3000/claim

# Seller invitation providers (ST1-013J) -- all optional; leave unset to keep a channel disabled.
# GET /api/marketplace-acquisition/provider-health reports which channels are actually usable.
# WhatsApp (Meta Cloud API):
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=
# Only 0 or 1 is supported -- see README.md known limitation.
WHATSAPP_TEMPLATE_BODY_PARAM_COUNT=1
# SMS (generic HTTP provider):
SELLER_INVITATION_SMS_API_URL=
SELLER_INVITATION_SMS_API_KEY=
SELLER_INVITATION_SMS_SENDER_ID=
# Email (Resend) -- used as a fallback when a seller has no phone:
RESEND_API_KEY=
EMAIL_FROM=

# Billing (apps/web/src/lib/billing) -- all optional; leave unset and /api/billing/upgrade and the
# Stripe/Paystack webhooks report PROVIDER_NOT_CONFIGURED instead of failing deep inside the SDK.
# Stripe (default provider):
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
# Annual recurring price IDs. Annual checkout fails closed when the selected
# plan's annual price ID is not configured; it never falls back to monthly.
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_PRO_ANNUAL=
# Paystack (used instead of Stripe when resolveBillingProvider sees country "GH"; country isn't
# collected anywhere in the live sign-up flow yet, so this path is currently unreachable in
# practice -- see apps/web/src/app/api/billing/upgrade/route.ts):
PAYSTACK_SECRET_KEY=
# Paystack recurring plan codes. Monthly values can continue using the
# existing defaults; annual checkout requires an explicit annual plan code.
PAYSTACK_PLAN_CODE_STARTER_ANNUAL=
PAYSTACK_PLAN_CODE_GROWTH_ANNUAL=
PAYSTACK_PLAN_CODE_PRO_ANNUAL=
# Where Stripe/Paystack send the customer back after checkout:
BILLING_CHECKOUT_SUCCESS_URL=http://localhost:3000/billing
BILLING_CHECKOUT_CANCEL_URL=http://localhost:3000/billing

# Queue drain cron (apps/web/src/app/api/internal/queue-drain, see README.md "Known gaps") --
# required for claim expiry, claim reminders, and growth-loop evaluation to actually run; without
# it the durable QueueJob table just accumulates unclaimed rows. Vercel sends
# `Authorization: Bearer $CRON_SECRET` automatically once this is set; the route refuses every
# request without it.
CRON_SECRET=

# WhispeRM API / pre-production environment template.
# Copy to a local .env file or configure these values in the target platform.
# Never commit real credentials or tenant/customer data.

# PostgreSQL system of record used by Prisma.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/whisperm?schema=public

# Redis is used for queueing, cache, and distributed coordination in deployed runtimes.
REDIS_URL=redis://localhost:6379

# Auth/session signing material. Use a long, random secret per environment.
AUTH_SESSION_SECRET=

# Email delivery. Resend is the current adapter used by provider-adapters.
RESEND_API_KEY=
EMAIL_FROM=WhispeRM <noreply@whisperm.ai>

# Billing/webhook providers. Configure only the providers enabled for the environment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Vercel/staging metadata. Vercel sets VERCEL and VERCEL_ENV automatically;
# set APP_BASE_URL/API_BASE_URL to the staging URLs used in emails and redirects.
VERCEL_ENV=preview
APP_BASE_URL=https://staging.whisperm.ai
API_BASE_URL=https://api-staging.whisperm.ai

# OpenTelemetry collector endpoint for pre-production traces/metrics/log correlation.
OTEL_EXPORTER_OTLP_ENDPOINT=

# WhispeRM API — environment variables. Never commit real secrets.
#
# NOTE (see README.md "Known gaps"): nothing in this repo currently calls apps/api's .listen() --
# treat it as a library of routes/services, not a running service, until a bootstrap entrypoint
# is added. This file documents what it would need once that entrypoint exists.

# Pooled connection, used at runtime.
DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct (non-pooled) connection, used for `prisma migrate deploy` only. Not read by
# prisma/schema.prisma's datasource block today -- export it as DATABASE_URL yourself when
# running migrations. See docs/production-deployment.md.
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
JWT_SECRET=
JWT_ISSUER=https://api.whisperm.io
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
RESEND_API_KEY=
EMAIL_FROM=WhispeRM <noreply@whisperm.io>
# Not read by any code in apps/api today (no queue/cache client is wired up yet). Documented for
# forward-compatibility with docs/production-deployment.md's deployment runbook.
REDIS_URL=
NODE_ENV=production
NEXT_PUBLIC_API_URL=https://api.whisperm.io

// Initial WhispeRM data model.
// This schema defines tenant-scoped persistence contracts only; no migrations are
// generated or executed from this change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ContentState {
  DRAFT
  REVIEW
  APPROVED
  ARCHIVED
}

enum PublishState {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum HealthStatus {
  HEALTHY
  DEGRADED
  UNHEALTHY
  UNKNOWN
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}


enum WorkflowExecutionState {
  PENDING
  SCHEDULED
  RUNNING
  WAITING_FOR_APPROVAL
  WAITING_FOR_EVENT
  RETRY_SCHEDULED
  SUCCEEDED
  FAILED
  CANCELLED
  DEAD_LETTERED
}

enum WorkflowStepExecutionState {
  PENDING
  RUNNING
  WAITING
  RETRY_SCHEDULED
  SUCCEEDED
  FAILED
  SKIPPED
  DEAD_LETTERED
}

enum AiExecutionState {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum EventPersistenceState {
  RECEIVED
  NORMALIZED
  PROCESSED
  FAILED
  DEAD_LETTERED
}

enum IdempotencyKeyState {
  IN_PROGRESS
  COMPLETED
  FAILED
  EXPIRED
}

enum QueueJobState {
  WAITING
  DELAYED
  ACTIVE
  COMPLETED
  FAILED
  RETRY_SCHEDULED
  DEAD_LETTERED
  CANCELLED
}

enum ExecutionLeaseState {
  ACTIVE
  RELEASED
  EXPIRED
  STOLEN
}

enum DistributedLockState {
  HELD
  RELEASED
  EXPIRED
}

enum EventDeliveryState {
  PENDING
  PUBLISHED
  CONSUMED
  FAILED
  DEAD_LETTERED
}

enum TraceSpanStatus {
  OK
  ERROR
  UNSET
}
enum ContactStage {
  PROSPECT
  QUALIFIED
  PROPOSAL
  ENGAGEMENT
  RENEWAL
  INACTIVE
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  TASK
  NOTE
}

enum DealStage {
  PROSPECT
  QUALIFIED
  PROPOSAL
  ENGAGEMENT
  RENEWAL
}

enum SubscriptionPlan {
  STARTER
  GROWTH
  PRO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}



model Tenant {
  id         String   @id @default(uuid()) @db.Uuid
  slug       String   @unique
  name       String
  externalId          String?  @unique
  alertDigestEnabled Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users                  TenantUser[]
  contacts               Contact[]
  contentItems           ContentItem[]
  contentVariants        ContentVariant[]
  inboundEvents          InboundEvent[]
  leadEvents             LeadEvent[]
  marketMoments          MarketMoment[]
  tenantSLOs             TenantSLO[]
  sloSnapshots           SloSnapshot[]
  reliabilityIncidents   ReliabilityIncident[]
  promptLibraryEntries   PromptLibraryEntry[]
  publishJobs            PublishJob[]
  auditLogs              AuditLog[]
  workflowExecutions     WorkflowExecution[]
  workflowStepExecutions WorkflowStepExecution[]
  aiExecutions           AiExecution[]
  eventIngestions        EventIngestion[]
  idempotencyKeys        IdempotencyKey[]
  vectorDocuments        VectorDocument[]
  executionTraces        ExecutionTrace[]
  executionTraceSpans    ExecutionTraceSpan[]
  queueJobs              QueueJob[]
  deadLetterJobs         DeadLetterJob[]
  scheduledJobs          ScheduledJob[]
  executionLeases        ExecutionLease[]
  distributedLocks       DistributedLock[]
  outboxEvents           OutboxEvent[]
  inboxEvents            InboxEvent[]
  deals                  Deal[]
  activities             Activity[]
  pipelines              Pipeline[]
  pipelineStages         PipelineStage[]
  subscriptions          Subscription[]
}

model TenantUser {
  id             String     @id @default(uuid()) @db.Uuid
  tenantId       String     @db.Uuid
  externalUserId String?
  email          String
  displayName    String?
  role           TenantRole @default(MEMBER)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contentItems    ContentItem[]
  ownedContacts   Contact[]     @relation("ContactOwner")
  ownedDeals      Deal[]        @relation("DealOwner")
  activities      Activity[]

  @@unique([tenantId, id])
  @@unique([tenantId, email])
  @@unique([tenantId, externalUserId])
  @@index([tenantId])
  @@index([tenantId, externalUserId])
}

model Contact {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  externalId  String?
  email       String?
  phone       String?
  firstName   String?
  lastName    String?
  company     String?
  stage       ContactStage @default(PROSPECT)
  source      String?
  ownerId     String?      @db.Uuid
  lastTouchAt DateTime?
  metadata    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner         TenantUser?    @relation("ContactOwner", fields: [tenantId, ownerId], references: [tenantId, id], onDelete: Restrict)
  contentItems  ContentItem[]
  inboundEvents InboundEvent[]
  leadEvents    LeadEvent[]
  deals         Deal[]
  activities    Activity[]

  @@unique([tenantId, id])
  @@unique([tenantId, externalId])
  @@index([tenantId])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@index([tenantId, externalId])
  @@index([tenantId, stage])
  @@index([tenantId, ownerId])
  @@index([tenantId, lastTouchAt])
}

model ContentItem {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @db.Uuid
  contactId       String?      @db.Uuid
  createdByUserId String?      @db.Uuid
  externalId      String?
  title           String
  state           ContentState @default(DRAFT)
  source          String?
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact       Contact?         @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict)
  createdByUser TenantUser?      @relation(fields: [tenantId, createdByUserId], references: [tenantId, id], onDelete: Restrict)
  variants      ContentVariant[]
  publishJobs   PublishJob[]

  @@unique([tenantId, id])
  @@unique([tenantId, externalId])
  @@index([tenantId])
  @@index([tenantId, contactId])
  @@index([tenantId, createdByUserId])
  @@index([tenantId, state])
  @@index([tenantId, externalId])
}

model ContentVariant {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @db.Uuid
  contentItemId String       @db.Uuid
  externalId    String?
  label         String
  channel       String
  version       Int          @default(1)
  state         ContentState @default(DRAFT)
  body          String
  metadata      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contentItem ContentItem  @relation(fields: [tenantId, contentItemId], references: [tenantId, id], onDelete: Cascade)
  publishJobs PublishJob[]

  @@unique([tenantId, id])
  @@unique([tenantId, externalId])
  @@unique([tenantId, contentItemId, version])
  @@index([tenantId])
  @@index([tenantId, contentItemId])
  @@index([tenantId, state])
  @@index([tenantId, externalId])
}

model InboundEvent {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  contactId     String?  @db.Uuid
  externalId    String?
  source        String
  eventType     String
  correlationId String?
  occurredAt    DateTime
  receivedAt    DateTime @default(now())
  payload       Json

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact    Contact?    @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict)
  leadEvents LeadEvent[]

  @@unique([tenantId, id])
  @@unique([tenantId, source, externalId])
  @@index([tenantId])
  @@index([tenantId, contactId])
  @@index([tenantId, externalId])
  @@index([tenantId, correlationId])
  @@index([tenantId, source, eventType, occurredAt])
}

model LeadEvent {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  contactId      String?  @db.Uuid
  inboundEventId String?  @db.Uuid
  externalId     String?
  eventType      String
  correlationId  String?
  occurredAt     DateTime
  payload        Json?
  createdAt      DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact      Contact?      @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict)
  inboundEvent InboundEvent? @relation(fields: [tenantId, inboundEventId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, externalId])
  @@index([tenantId])
  @@index([tenantId, contactId, occurredAt])
  @@index([tenantId, inboundEventId])
  @@index([tenantId, externalId])
  @@index([tenantId, correlationId])
  @@index([tenantId, eventType, occurredAt])
}

model MarketMoment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  externalId  String?
  source      String
  title       String
  description String?
  occurredAt  DateTime
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, externalId])
  @@index([tenantId])
  @@index([tenantId, externalId])
  @@index([tenantId, source, occurredAt])
}

model TenantSLO {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  name         String
  description  String?
  target       Float
  window       String
  healthStatus HealthStatus @default(UNKNOWN)
  isEnabled    Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  snapshots   SloSnapshot[]
  incidents   ReliabilityIncident[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, healthStatus])
}

model SloSnapshot {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  tenantSloId  String       @db.Uuid
  capturedAt   DateTime
  value        Float
  healthStatus HealthStatus
  metadata     Json?
  createdAt    DateTime     @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantSLO TenantSLO @relation(fields: [tenantId, tenantSloId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, tenantSloId, capturedAt])
  @@index([tenantId, healthStatus, capturedAt])
}

model ReliabilityIncident {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  tenantSloId  String?          @db.Uuid
  externalId   String?
  title        String
  summary      String?
  severity     IncidentSeverity
  healthStatus HealthStatus     @default(UNHEALTHY)
  startedAt    DateTime
  resolvedAt   DateTime?
  metadata     Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantSLO TenantSLO? @relation(fields: [tenantId, tenantSloId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, externalId])
  @@index([tenantId])
  @@index([tenantId, externalId])
  @@index([tenantId, tenantSloId, startedAt])
  @@index([tenantId, severity, startedAt])
  @@index([tenantId, healthStatus, startedAt])
}

model PromptLibraryEntry {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  key         String
  version     Int      @default(1)
  name        String
  description String?
  prompt      String
  metadata    Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, key, version])
  @@index([tenantId])
  @@index([tenantId, key])
  @@index([tenantId, isActive])
}

model PublishJob {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @db.Uuid
  contentItemId    String?      @db.Uuid
  contentVariantId String?      @db.Uuid
  externalId       String?
  idempotencyKey   String?
  target           String
  state            PublishState @default(QUEUED)
  attempts         Int          @default(0)
  scheduledAt      DateTime?
  startedAt        DateTime?
  finishedAt       DateTime?
  errorMessage     String?
  metadata         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contentItem    ContentItem?    @relation(fields: [tenantId, contentItemId], references: [tenantId, id], onDelete: Restrict)
  contentVariant ContentVariant? @relation(fields: [tenantId, contentVariantId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, externalId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([tenantId, contentItemId])
  @@index([tenantId, contentVariantId])
  @@index([tenantId, externalId])
  @@index([tenantId, idempotencyKey])
  @@index([tenantId, state, scheduledAt])
}



// CRM product models — expand-only, tenant-scoped, rollback-safe.
// No migration generation from this file.

model Pipeline {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  name       String
  isDefault  Boolean  @default(false)
  defaultKey String?  @default("default")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages PipelineStage[]
  deals  Deal[]

  @@unique([tenantId, id])
  @@unique([tenantId, defaultKey])
  @@index([tenantId])
  @@index([tenantId, isDefault])
}

model PipelineStage {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  pipelineId String   @db.Uuid
  name       String
  position   Int
  color      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline Pipeline @relation(fields: [tenantId, pipelineId], references: [tenantId, id], onDelete: Cascade)
  deals    Deal[]

  @@unique([tenantId, id])
  @@unique([tenantId, pipelineId, id])
  @@unique([tenantId, pipelineId, name])
  @@unique([tenantId, pipelineId, position])
  @@index([tenantId])
  @@index([tenantId, pipelineId])
  @@index([tenantId, pipelineId, position])
}

model Deal {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  contactId       String?  @db.Uuid
  pipelineId      String   @db.Uuid
  pipelineStageId String   @db.Uuid
  ownerId         String?  @db.Uuid
  externalId      String?
  title           String
  value           Decimal? @db.Decimal(18, 4)
  currency        String   @default("USD")
  probability     Int?
  closedAt        DateTime?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact       Contact?      @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict)
  pipeline      Pipeline      @relation(fields: [tenantId, pipelineId], references: [tenantId, id], onDelete: Restrict)
  pipelineStage PipelineStage @relation(fields: [tenantId, pipelineId, pipelineStageId], references: [tenantId, pipelineId, id], onDelete: Restrict)
  owner         TenantUser?   @relation("DealOwner", fields: [tenantId, ownerId], references: [tenantId, id], onDelete: Restrict)
  activities    Activity[]

  @@unique([tenantId, id])
  @@unique([tenantId, externalId])
  @@index([tenantId])
  @@index([tenantId, contactId])
  @@index([tenantId, pipelineId])
  @@index([tenantId, pipelineStageId])
  @@index([tenantId, ownerId])
  @@index([tenantId, pipelineId, pipelineStageId])
  @@index([tenantId, externalId])
}

model Activity {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  contactId   String?      @db.Uuid
  dealId      String?      @db.Uuid
  createdById String       @db.Uuid
  type        ActivityType
  note        String?
  occurredAt  DateTime     @default(now())
  metadata    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact   Contact?    @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict)
  deal      Deal?       @relation(fields: [tenantId, dealId], references: [tenantId, id], onDelete: Restrict)
  createdBy TenantUser  @relation(fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, contactId, occurredAt])
  @@index([tenantId, dealId, occurredAt])
  @@index([tenantId, createdById])
  @@index([tenantId, type, occurredAt])
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  tenantId               String             @db.Uuid
  plan                   SubscriptionPlan   @default(STARTER)
  status                 SubscriptionStatus @default(TRIALING)
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  paystackCustomerId     String?
  paystackSubscriptionId String?
  currency               String             @default("USD")
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  trialEndsAt            DateTime?
  canceledAt             DateTime?
  metadata               Json?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, stripeCustomerId])
  @@unique([tenantId, paystackCustomerId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, plan, status])
  @@index([tenantId, trialEndsAt])
}

// Persistence foundation models below are additive and tenant-scoped. They are
// organized as expand-only schema primitives so generated migrations can be
// rolled out safely before application code starts writing to them.

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  actorId       String?
  action        String
  targetType    String
  targetId      String?
  correlationId String
  requestId     String?
  occurredAt    DateTime @default(now())
  metadata      Json?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, actorId, occurredAt])
  @@index([tenantId, action, occurredAt])
  @@index([tenantId, targetType, targetId])
  @@index([tenantId, correlationId])
}

model WorkflowExecution {
  id              String                 @id @default(uuid()) @db.Uuid
  tenantId        String                 @db.Uuid
  workflowId      String
  workflowVersion Int
  runId           String
  state           WorkflowExecutionState @default(PENDING)
  idempotencyKey  String?
  input           Json                   @default("{}")
  output          Json?
  error           Json?
  correlationId   String
  causationId     String?
  scheduledAt     DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  tenant Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps  WorkflowStepExecution[]
  leases ExecutionLease[]

  @@unique([tenantId, id])
  @@unique([tenantId, runId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, workflowId, workflowVersion])
  @@index([tenantId, state, scheduledAt])
  @@index([tenantId, correlationId])
}

model WorkflowStepExecution {
  id                  String                     @id @default(uuid()) @db.Uuid
  tenantId            String                     @db.Uuid
  workflowExecutionId String                     @db.Uuid
  stepId              String
  state               WorkflowStepExecutionState @default(PENDING)
  attempt             Int                        @default(0)
  maxAttempts         Int                        @default(1)
  input               Json                       @default("{}")
  output              Json?
  error               Json?
  scheduledAt         DateTime?
  startedAt           DateTime?
  finishedAt          DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflowExecution WorkflowExecution @relation(fields: [tenantId, workflowExecutionId], references: [tenantId, id], onDelete: Cascade)
  leases            ExecutionLease[]

  @@unique([tenantId, id])
  @@unique([tenantId, workflowExecutionId, stepId])
  @@index([tenantId, workflowExecutionId])
  @@index([tenantId, state, scheduledAt])
}

model AiExecution {
  id                  String           @id @default(uuid()) @db.Uuid
  tenantId            String           @db.Uuid
  workflowExecutionId String?          @db.Uuid
  providerId          String
  providerKind        String
  model               String
  state               AiExecutionState @default(PENDING)
  idempotencyKey      String?
  promptHash          String
  request             Json
  response            Json?
  usage               Json?
  error               Json?
  correlationId       String
  startedAt           DateTime?
  finishedAt          DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, workflowExecutionId])
  @@index([tenantId, providerId, model])
  @@index([tenantId, state, createdAt])
  @@index([tenantId, correlationId])
}

model EventIngestion {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @db.Uuid
  provider       String
  providerEventId String
  eventType      String
  idempotencyKey String
  state          EventPersistenceState @default(RECEIVED)
  occurredAt     DateTime
  receivedAt     DateTime              @default(now())
  processedAt    DateTime?
  payload        Json
  error          Json?
  correlationId  String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, provider, providerEventId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, state, receivedAt])
  @@index([tenantId, eventType, occurredAt])
  @@index([tenantId, correlationId])
}

model IdempotencyKey {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @db.Uuid
  scope          String
  key            String
  requestHash    String
  state          IdempotencyKeyState  @default(IN_PROGRESS)
  response       Json?
  lockedUntil    DateTime?
  expiresAt      DateTime
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, scope, key])
  @@index([tenantId, state, expiresAt])
  @@index([tenantId, lockedUntil])
}

model VectorDocument {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  sourceType         String
  sourceId           String
  chunkId            String
  embeddingModel     String?
  embeddingDimension Int?
  contentHash        String
  metadata           Json     @default("{}")
  indexedAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, sourceType, sourceId, chunkId])
  @@index([tenantId, sourceType, sourceId])
  @@index([tenantId, embeddingModel])
  @@index([tenantId, contentHash])
}

model ExecutionTrace {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  traceId       String
  rootSpanId    String?
  correlationId String
  startedAt     DateTime
  endedAt       DateTime?
  attributes    Json     @default("{}")

  tenant Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  spans  ExecutionTraceSpan[]

  @@unique([tenantId, id])
  @@unique([tenantId, traceId])
  @@index([tenantId, correlationId])
  @@index([tenantId, startedAt])
}

model ExecutionTraceSpan {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @db.Uuid
  executionTraceId String          @db.Uuid
  spanId           String
  parentSpanId     String?
  name             String
  status           TraceSpanStatus @default(UNSET)
  startedAt        DateTime
  endedAt          DateTime?
  attributes       Json            @default("{}")

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  executionTrace ExecutionTrace @relation(fields: [tenantId, executionTraceId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, executionTraceId, spanId])
  @@index([tenantId, executionTraceId])
  @@index([tenantId, status, startedAt])
}

model QueueJob {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  queueName      String
  jobName        String
  jobKey         String
  state          QueueJobState @default(WAITING)
  payload        Json
  attemptsMade   Int           @default(0)
  maxAttempts    Int           @default(1)
  scheduledAt    DateTime?
  availableAt    DateTime      @default(now())
  lockedUntil    DateTime?
  lastError      Json?
  correlationId  String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, queueName, jobKey])
  @@index([tenantId, queueName, state, availableAt])
  @@index([tenantId, lockedUntil])
  @@index([tenantId, correlationId])
}

model DeadLetterJob {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  queueName     String
  jobName       String
  jobKey        String
  payload       Json
  reason        String
  attemptsMade  Int
  failedAt      DateTime @default(now())
  correlationId String
  metadata      Json?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, queueName, jobKey])
  @@index([tenantId, queueName, failedAt])
  @@index([tenantId, correlationId])
}

model ScheduledJob {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid
  scheduleName  String
  jobName       String
  cron          String?
  runAt         DateTime?
  payload       Json          @default("{}")
  state         QueueJobState @default(WAITING)
  nextRunAt     DateTime?
  lastRunAt     DateTime?
  correlationId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, scheduleName])
  @@index([tenantId, state, nextRunAt])
}

model ExecutionLease {
  id                      String              @id @default(uuid()) @db.Uuid
  tenantId                String              @db.Uuid
  leaseKey                String
  holderId                String
  workflowExecutionId     String?             @db.Uuid
  workflowStepExecutionId String?             @db.Uuid
  state                   ExecutionLeaseState @default(ACTIVE)
  fencingToken            BigInt
  acquiredAt              DateTime            @default(now())
  expiresAt               DateTime
  releasedAt              DateTime?
  correlationId           String

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflowExecution     WorkflowExecution?     @relation(fields: [tenantId, workflowExecutionId], references: [tenantId, id], onDelete: Cascade)
  workflowStepExecution WorkflowStepExecution? @relation(fields: [tenantId, workflowStepExecutionId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, leaseKey, fencingToken])
  @@index([tenantId, leaseKey, state, expiresAt])
  @@index([tenantId, holderId])
}

model DistributedLock {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @db.Uuid
  lockKey       String
  holderId      String
  state         DistributedLockState @default(HELD)
  fencingToken  BigInt
  acquiredAt    DateTime             @default(now())
  expiresAt     DateTime
  releasedAt    DateTime?
  correlationId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, lockKey, fencingToken])
  @@index([tenantId, lockKey, state, expiresAt])
  @@index([tenantId, holderId])
}

model OutboxEvent {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @db.Uuid
  aggregateType  String
  aggregateId    String
  eventType      String
  eventVersion   Int                @default(1)
  idempotencyKey String
  payload        Json
  headers        Json               @default("{}")
  state          EventDeliveryState @default(PENDING)
  availableAt    DateTime           @default(now())
  publishedAt    DateTime?
  attemptsMade   Int                @default(0)
  correlationId  String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, state, availableAt])
  @@index([tenantId, aggregateType, aggregateId])
  @@index([tenantId, correlationId])
}

model InboxEvent {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @db.Uuid
  source         String
  messageId      String
  eventType      String
  payload        Json
  headers        Json               @default("{}")
  state          EventDeliveryState @default(PENDING)
  receivedAt     DateTime           @default(now())
  processedAt    DateTime?
  attemptsMade   Int                @default(0)
  correlationId  String
  error          Json?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, source, messageId])
  @@index([tenantId, state, receivedAt])
  @@index([tenantId, eventType, receivedAt])
  @@index([tenantId, correlationId])
}

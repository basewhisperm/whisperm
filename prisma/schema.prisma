  updatedAt      DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, queueName, jobKey])
  @@index([tenantId, queueName, state, availableAt])
  @@index([tenantId, lockedUntil])
  @@index([tenantId, correlationId])
}

model DeadLetterJob {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  queueName     String
  jobName       String
  jobKey        String
  payload       Json
  reason        String
  attemptsMade  Int
  failedAt      DateTime @default(now())
  correlationId String
  metadata      Json?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, queueName, jobKey])
  @@index([tenantId, queueName, failedAt])
  @@index([tenantId, correlationId])
}

model ScheduledJob {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid
  scheduleName  String
  jobName       String
  cron          String?
  runAt         DateTime?
  payload       Json          @default("{}")
  state         QueueJobState @default(WAITING)
  nextRunAt     DateTime?
  lastRunAt     DateTime?
  correlationId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, scheduleName])
  @@index([tenantId, state, nextRunAt])
}

model ExecutionLease {
  id                      String              @id @default(uuid()) @db.Uuid
  tenantId                String              @db.Uuid
  leaseKey                String
  holderId                String
  workflowExecutionId     String?             @db.Uuid
  workflowStepExecutionId String?             @db.Uuid
  state                   ExecutionLeaseState @default(ACTIVE)
  fencingToken            BigInt
  acquiredAt              DateTime            @default(now())
  expiresAt               DateTime
  releasedAt              DateTime?
  correlationId           String

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflowExecution     WorkflowExecution?     @relation(fields: [tenantId, workflowExecutionId], references: [tenantId, id], onDelete: Cascade)
  workflowStepExecution WorkflowStepExecution? @relation(fields: [tenantId, workflowStepExecutionId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, leaseKey, fencingToken])
  @@index([tenantId, leaseKey, state, expiresAt])
  @@index([tenantId, holderId])
}

model DistributedLock {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @db.Uuid
  lockKey       String
  holderId      String
  state         DistributedLockState @default(HELD)
  fencingToken  BigInt
  acquiredAt    DateTime             @default(now())
  expiresAt     DateTime
  releasedAt    DateTime?
  correlationId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, lockKey, fencingToken])
  @@index([tenantId, lockKey, state, expiresAt])
  @@index([tenantId, holderId])
}

model OutboxEvent {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @db.Uuid
  aggregateType  String
  aggregateId    String
  eventType      String
  eventVersion   Int                @default(1)
  idempotencyKey String
  payload        Json
  headers        Json               @default("{}")
  state          EventDeliveryState @default(PENDING)
  availableAt    DateTime           @default(now())
  publishedAt    DateTime?
  attemptsMade   Int                @default(0)
  correlationId  String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, state, availableAt])
  @@index([tenantId, aggregateType, aggregateId])
  @@index([tenantId, correlationId])
}

model InboxEvent {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @db.Uuid
  source         String
  messageId      String
  eventType      String
  payload        Json
  headers        Json               @default("{}")
  state          EventDeliveryState @default(PENDING)
  receivedAt     DateTime           @default(now())

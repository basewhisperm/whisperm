{
  "name": "whisperm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm --filter @whisperm/types build && pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "seed:pipelines": "node prisma/seed.mjs",
    "build": "pnpm -r --if-present run build",
    "seed:founding-workspaces": "node prisma/founding-workspaces-seed.mjs",
    "typecheck:strict": "pnpm --filter @whisperm/types build && pnpm --filter @whisperm/notification-runtime build && pnpm --filter @whisperm/repositories build && pnpm -r --if-present run typecheck",
    "postinstall": "prisma generate",
    "tenant-feature": "node scripts/tenant-feature.mjs",
    "test:tenant-feature": "node --test scripts/tenant-feature.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "eslint": "^8.57.0",
    "prisma": "5.22.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  }
}
